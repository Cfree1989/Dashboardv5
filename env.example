# 3D Print Management System - Environment Configuration
# Copy this file to .env and configure the values for your environment
# 
# SECURITY WARNING: Never commit the actual .env file with real values to git
# Use strong, unique passwords and secrets in production

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
# FLASK_ENV=production  # Use for production deployment

# Application Security
# Generate a strong secret key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Application Version and Environment Banner
APP_VERSION=v3.1.2
ENVIRONMENT_BANNER=Development Environment
# ENVIRONMENT_BANNER=Production Environment  # Use for production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your-db-password@db:5432/3d_print_system

# PostgreSQL Container Configuration (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=3d_print_system

# =============================================================================
# REDIS CACHE/QUEUE CONFIGURATION  
# =============================================================================

# Redis Connection URL
REDIS_URL=redis://:your-redis-password@redis:6379
REDIS_PASSWORD=your-redis-password

# Analytics Caching Configuration
ANALYTICS_CACHE_TTL=60

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Server Settings (Example for Microsoft Office 365)
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Email Authentication
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=3D Print System <your-email@domain.com>

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================

# JWT Cookie Settings
JWT_COOKIE_NAME=auth_token
JWT_COOKIE_SECURE=false
# JWT_COOKIE_SECURE=true  # Set to true in production with HTTPS
JWT_COOKIE_HTTPONLY=true
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
# JWT_COOKIE_DOMAIN=yourdomain.com  # Set your domain for production
JWT_COOKIE_PATH=/
JWT_COOKIE_MAX_AGE=43200

# =============================================================================
# WORKSTATION AUTHENTICATION
# =============================================================================

# Development workstation password (for testing)
WORKSTATION_DEVELOPMENT=password123

# Production workstation passwords (use strong passwords)
WORKSTATION_1=Fabrication
WORKSTATION_2=Engineering  
WORKSTATION_3=AdminWorkstation

# =============================================================================
# FILE HANDLING CONFIGURATION
# =============================================================================

# Storage Directory Path
STORAGE_PATH=storage

# File Upload Restrictions
ALLOWED_FILE_EXTENSIONS=stl,obj,3mf,form,idea
FILE_EXTENSION_PRIORITY=3mf,form,idea,stl,obj
MAX_FILE_SIZE_MB=50
MIN_FILE_SIZE_KB=1

# Feature Toggles
ATOMIC_FILE_OPERATIONS_ENABLED=true

# =============================================================================
# FRONTEND/API INTEGRATION
# =============================================================================

# Frontend Public URL (used in email links and API responses)
FRONTEND_PUBLIC_URL=http://localhost:3000
# FRONTEND_PUBLIC_URL=https://yourdomain.com  # Use your domain for production

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api  # Use your domain for production (via nginx proxy)
NODE_ENV=development
# NODE_ENV=production  # Use for production

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# Domain Configuration (Required for SSL)
DOMAIN_NAME=localhost
# DOMAIN_NAME=yourdomain.com  # Your actual domain for production

# SSL Certificate Email (for Let's Encrypt)
SSL_EMAIL=admin@localhost
# SSL_EMAIL=admin@yourdomain.com  # Your email for Let's Encrypt notifications

# SSL Certificate Type (self-signed|letsencrypt|custom)
SSL_TYPE=self-signed
# SSL_TYPE=letsencrypt  # Use for production with automatic certificates

# Custom SSL Certificate Paths (if using SSL_TYPE=custom)
# SSL_CERT_PATH=/path/to/certificate.pem
# SSL_KEY_PATH=/path/to/private-key.pem

# SSL Health Check Configuration
SSL_WARNING_DAYS=30
SSL_CRITICAL_DAYS=7
SSL_MONITOR_INTERVAL=300

# =============================================================================
# DEVELOPMENT SETTINGS (REMOVE IN PRODUCTION)
# =============================================================================

# Flask Debug Mode (NEVER enable in production)
FLASK_DEBUG=false
# FLASK_DEBUG=true  # Only for local development

# =============================================================================
# PRODUCTION SECURITY CHECKLIST
# =============================================================================
# 
# Before deploying to production, ensure:
# 
# 1. SECRET_KEY is a strong, randomly generated value
# 2. All passwords are strong and unique
# 3. FLASK_ENV=production
# 4. JWT_COOKIE_SECURE=true (requires HTTPS)
# 5. JWT_COOKIE_DOMAIN is set to your domain
# 6. FLASK_DEBUG=false (or remove entirely)
# 7. FRONTEND_PUBLIC_URL and NEXT_PUBLIC_API_URL use HTTPS URLs
# 8. Database and Redis are not exposed to public internet
# 9. ENVIRONMENT_BANNER clearly indicates production
# 10. Email credentials are for a service account, not personal account
#
# =============================================================================
