# 3D Print Management System - Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Credentials (CRITICAL - Change these!)
POSTGRES_USER=fablab_user
POSTGRES_PASSWORD=your_secure_password_here

# Database Connection URL (auto-generated from above credentials)
DATABASE_URL=postgresql://fablab_user:your_secure_password_here@db:5432/3d_print_system

# Legacy database variables (for compatibility)
DB_USER=fablab_user
DB_PASSWORD=your_secure_password_here
PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection URL (for background job processing)
REDIS_URL=redis://redis:6379

# =============================================================================
# APPLICATION SECURITY
# =============================================================================

# Flask Secret Key (CRITICAL - Generate a secure random key!)
SECRET_KEY=your_secure_secret_key_here

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Server Settings
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Email Authentication (CRITICAL - Use real credentials!)
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password_here
MAIL_DEFAULT_SENDER=your_email@example.com

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend Public URL (for email links and redirects)
FRONTEND_PUBLIC_URL=http://localhost:3000

# Application Base URL
BASE_URL=http://localhost:5000

# =============================================================================
# STAFF AUTHENTICATION
# =============================================================================

# Staff Password (CRITICAL - Change this!)
STAFF_PASSWORD=your_secure_staff_password_here

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# File Storage Path (relative to project root)
STORAGE_PATH=storage

# =============================================================================
# FILE PROCESSING CONFIGURATION
# =============================================================================

# Allowed Model File Extensions
ALLOWED_MODEL_EXTS=.stl,.obj,.3mf,.form,.idea

# Authoritative Extension Priority (for file selection)
AUTHORITATIVE_EXT_PRIORITY=.3mf,.form,.idea,.stl,.obj

# =============================================================================
# ANALYTICS CONFIGURATION
# =============================================================================

# Analytics Cache TTL (seconds)
ANALYTICS_CACHE_TTL=60

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=true

# Flask Application Entry Point
FLASK_APP=run.py

# =============================================================================
# SECURITY NOTES
# =============================================================================

# IMPORTANT: 
# 1. Generate secure passwords for POSTGRES_PASSWORD, SECRET_KEY, and STAFF_PASSWORD
# 2. Use real email credentials for MAIL_USERNAME and MAIL_PASSWORD
# 3. Never commit the actual .env file to version control
# 4. Use different credentials for development, staging, and production

# To generate a secure SECRET_KEY, run:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# To generate a secure POSTGRES_PASSWORD, run:
# python -c "import secrets; print(secrets.token_urlsafe(16))"

# To generate a secure STAFF_PASSWORD, run:
# python -c "import secrets; print(secrets.token_urlsafe(12))"
